# Copy this file to .env.local once Better Wealth owns a Supabase project.
# Never put service-role keys in a NEXT_PUBLIC_ variable or commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email. EMAIL_FROM must use a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="Better Wealth Investment Group <updates@bwiginvest.com>"
NEXT_PUBLIC_SITE_URL=https://www.bwiginvest.com
